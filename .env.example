# ------------------------------------------------------------------
# Docloom environment variables
# Copy this file to .env.local for local development.
# For staging/production, copy to .env.staging / .env.production
# (see .env.staging.example and .env.production.example).
# Never commit real secrets.
# ------------------------------------------------------------------

# Public URL of this deployment (used to build GitHub OAuth callback URIs).
# For local dev this is http://localhost:3000
# No trailing slash (one would be stripped anyway). The GitHub App must have
# {APP_URL}/api/auth/github/callback registered as a callback URL — exactly.
APP_URL=http://localhost:3000

# --- GitHub App (https://github.com/settings/apps) -----------------
# Permissions required on the app: Contents (read-only), Metadata (read-only).
# Enable "Request user authorization (OAuth) during installation".
# Register callback URL: {APP_URL}/api/auth/github/callback  (must match
# character for character — wrong scheme, host, port or path = GitHub's
# "Invalid Redirect URI" page before the user ever gets back to us)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# PEM private key of the GitHub App. Either paste the full
# "-----BEGIN RSA PRIVATE KEY-----" PEM block or a base64 encoding of it.
GITHUB_PRIVATE_KEY=

# --- GitHub webhook (auto-regenerate on merge) ----------------------
# Webhook secret — the SAME value must be set in the GitHub App's webhook
# settings ("Webhook secret" field) and here. Without it every delivery to
# /api/webhooks/github is rejected with 401.
GITHUB_WEBHOOK_SECRET=
# Bearer token that protects /api/cron/regen — the 5-minute fallback that
# re-drives queued auto-regenerate runs. The external scheduler sends it as
# `Authorization: Bearer <DOCLOOM_CRON_SECRET>`.
DOCLOOM_CRON_SECRET=
# Optional overrides (defaults shown):
# DOCLOOM_WEBHOOK_MAX_FILES=20
# DOCLOOM_WEBHOOK_DEBOUNCE_SECONDS=60
# DOCLOOM_CRON_MAX_RUNS=1

# --- Session & encryption ------------------------------------------
# Random string >= 32 chars. Used to sign the httpOnly session cookie (HS256).
SESSION_SECRET=
# Base64 of 32 random bytes (openssl rand -base64 32).
# Used to AES-256-GCM encrypt GitHub tokens at rest.
ENCRYPTION_KEY=

# --- Postgres (Neon) -----------------------------------------------
# REQUIRED: the POOLED connection string from Neon dashboard (host contains
# "-pooler."). Docloom uses Neon's fetch-based HTTP driver exclusively, which
# needs the pooled endpoint. Only user/repo metadata is stored — never source
# code.
DATABASE_URL=
# --- Plan limit overrides (optional) --------------------------------
# DOCLOOM_DAILY_GENERATION_LIMIT=5
# DOCLOOM_DAILY_GENERATION_LIMIT=5          # free tier daily gen cap
# DOCLOOM_DAILY_LIMIT_PRO=25               # pro tier daily gen cap
# DOCLOOM_DAILY_LIMIT_TEAM=100             # team tier daily gen cap
# DOCLOOM_MAX_REPOS_FREE=1                 # free tier repo cap
# DOCLOOM_MAX_REPOS_PRO=5                  # pro tier repo cap
# DOCLOOM_MAX_REPOS_TEAM=20                # team tier repo cap
# DOCLOOM_ANNUAL_MULT=10                   # annual billing multiplier (10x monthly)

# --- Dodo Products (live credentials; test mode uses the same ids) ---
# Product ids from the Dodo dashboard — one per sellable plan.
# DODO_PRO_PRODUCT_ID=
# DODO_TEAM_PRODUCT_ID=

# --- Rate limiting (optional overrides) -----------------------------
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000
# --- Internal admin dashboard (/admin) ------------------------------
# Comma-separated GitHub logins allowed to open /admin. Unset = nobody can
# (the route 404s for everyone), so this must be set for the dashboard to work.
# ADMIN_GITHUB_LOGINS=babarkhan

# --- Playground (/playground, no-signup demo) -----------------------
# Optional GitHub PAT (public_repo scope is enough) for the playground's
# public-API calls. Strongly recommended in production: without it GitHub's
# anonymous limit (60 req/h) allows roughly ONE playground run per hour and
# PLAYGROUND_HOURLY_RUN_CAP defaults to 1. With a token the cap defaults to 60.
# PLAYGROUND_GITHUB_TOKEN=
# Overrides (defaults shown):
# PLAYGROUND_MAX_FILES=25
# PLAYGROUND_MAX_FILE_BYTES=65536
# PLAYGROUND_SCHEMA_FETCH_BUDGET=10
# PLAYGROUND_TREE_ENTRY_CAP=20000
# PLAYGROUND_MAX_MARKDOWN_BYTES=3000000
# PLAYGROUND_DAILY_IP_LIMIT=5
# PLAYGROUND_HOURLY_RUN_CAP=60
# PLAYGROUND_CONCURRENCY=2

# --- Ops alerting (optional, recommended in staging/production) -----
# Webhook that receives operational failure alerts as Slack-compatible
# { text } POSTs: unhandled route errors, failed generation runs, billing
# webhook failures, failed account deletions. A Slack incoming-webhook URL
# works directly; for Discord append /slack to its webhook URL. Unset =
# alerts disabled (the default for local dev).
# DOCLOOM_ALERT_WEBHOOK_URL=